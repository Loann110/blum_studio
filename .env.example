# Copy to .env (git-ignored) next to this file. Blum reads it at start;
# a variable already set in your shell wins over the file.

# Free stock photos for agents (list_resources('photos') + import_image('pexels:<id>')).
# Keys: https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
# You can also paste them in Settings > Stock photos instead.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional
# BLUM_PORT=8092
