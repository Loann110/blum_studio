{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/js",
    "rootDir": "..",
    "declaration": false,
    "sourceMap": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "playwright-core": [
        "../ui/node_modules/playwright-core"
      ],
      "zod": [
        "../ui/node_modules/zod"
      ],
      "@modelcontextprotocol/sdk/server/mcp.js": [
        "../ui/node_modules/@modelcontextprotocol/sdk/dist/esm/server/mcp.d.ts"
      ],
      "@modelcontextprotocol/sdk/server/stdio.js": [
        "../ui/node_modules/@modelcontextprotocol/sdk/dist/esm/server/stdio.d.ts"
      ]
    },
    "allowUnreachableCode": false
  },
  "include": [
    "**/*.ts",
    "../ui/engine/**/*.ts"
  ]
}
